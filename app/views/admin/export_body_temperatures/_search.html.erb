<%= form_with url: admin_temperatures_path, method: :get, local: true do |f| %>
  <div class="row float-end">
    <div class="col-md-auto me-1 p-2 border border-dark">
      <%= f.label :search_measurement_date, '検温年月' %>
      <% if selected_search_measurement_date_start.present? %>
        <%= f.date_select :search_measurement_date, { use_month_numbers: true, discard_day: true, selected: selected_search_measurement_date_start }, { class:'form-select-sm d-inline-block w-auto' } %>
      <% else %>
        <%= f.date_select :search_measurement_date, { use_month_numbers: true, discard_day: true, prompt: '--' }, { class:'form-select-sm d-inline-block w-auto' } %>
      <% end %>
    </div>
    <div class="col-md-auto me-0">
      <%= f.submit '検索', class: 'btn btn-primary btn-sm ms-1 mt-3' %>
    </div>
  </div>
<% end %>
