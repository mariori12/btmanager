<div class="app-title navbar navbar-expand-md navbar-light bg-light">
  <div class="navbar-brand ms-3">BTmanager</div>
  <ul class="navbar-nav ms-auto">
    <% if logged_in? %>
      <li class="nav-item px-1"><%= link_to '体温一覧', body_temperatures_path, class: 'nav-link' %></li>
      <% if current_user.admin? %>
        <li class="nav-item px-1"><%= link_to 'ユーザ一覧', admin_users_path, class: 'nav-link' %></li>
        <li class="nav-item px-1"><%= link_to '帳票出力', admin_temperatures_path, class: 'nav-link' %></li>
      <% end %>
      <li class="nav-item px-1"><%= link_to 'ログアウト', logout_path, method: :delete, class: 'nav-link' %> </li>
    <% else %>
      <li class="nav-item px-1"><%= link_to 'ログイン', login_path, class: 'nav-link' %></li>
    <% end %>
  </ul>
</div>
